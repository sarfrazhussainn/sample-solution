# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# TypeScript Build Cache
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env.local
**/.env*.local
*.pem

# Debug & Error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor folders
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Vercel & Deployment
.vercel/
**/.vercel/

# AI & Temporary workspace files
.gemini/
.agents/
.agent/
*.tmp
*.temp
